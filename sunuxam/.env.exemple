===================================================================

# Base de donnees PostgreSQL
SUNUXAM_DB_URL=jdbc:postgresql://localhost:5432/sunuxam
SUNUXAM_DB_UTILISATEUR=sunuxam
SUNUXAM_DB_MOT_DE_PASSE=sunuxam

# Serveur
SUNUXAM_PORT=8080

# JPA
SUNUXAM_JPA_DDL=update
SUNUXAM_JPA_SHOW_SQL=true

# Securite JWT (secret >= 32 octets obligatoire)
SUNUXAM_JWT_SECRET=changez-cette-cle-secrete-de-developpement-32-octets-minimum
SUNUXAM_JWT_DUREE_MS=86400000
SUNUXAM_JWT_EMETTEUR=sunuxam

# Compte administrateur initial
SUNUXAM_ADMIN_INIT=true
SUNUXAM_ADMIN_NOM=Administrateur
SUNUXAM_ADMIN_PRENOM=SunuXam
SUNUXAM_ADMIN_EMAIL=admin@sunuxam.sn
SUNUXAM_ADMIN_MOT_DE_PASSE=Admin@123456
